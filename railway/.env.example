# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =============================================================================

# Opción 1: URL completa de conexión (RECOMENDADO PARA RAILWAY)
# Railway automáticamente provee esta variable - NO la configures manualmente
# DATABASE_URL=postgresql://username:password@host:port/database

# Opción 2: Variables individuales para PostgreSQL (desarrollo local)
# DB_TYPE=postgresql
# PGUSER=postgres
# PGPASSWORD=tu_password_local
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=storesdb

# Opción 3: Variables para MySQL (alternativa)
# DB_TYPE=mysql
# DB_USER=root
# DB_PASSWORD=tu_password_local
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=storesdb

# Opción 4: SQLite (desarrollo local - predeterminado)
# DB_TYPE=sqlite
# No requiere configuración adicional

# =============================================================================
# CONFIGURACIÓN JWT (⚠️ GENERA CLAVES ÚNICAS Y SEGURAS)
# =============================================================================
# NUNCA uses estos valores de ejemplo en producción
# Genera tus propias claves con: python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET_KEY=CAMBIA-ESTA-CLAVE-POR-UNA-SEGURA
JWT_ACCESS_TOKEN_EXPIRES=86400

# =============================================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =============================================================================
FLASK_ENV=development
SECRET_KEY=CAMBIA-ESTA-CLAVE-TAMBIEN
DEBUG=True

# Para Railway/Producción:
# FLASK_ENV=production
# SECRET_KEY=<genera-una-clave-unica-segura>
# JWT_SECRET_KEY=<genera-otra-clave-diferente-segura>
# DEBUG=False

# =============================================================================
# 🔐 IMPORTANTE SOBRE SEGURIDAD
# =============================================================================
# 
# 1. Este archivo es una PLANTILLA
# 2. Copia este archivo a la raíz como .env
# 3. Reemplaza TODOS los valores de ejemplo con valores reales
# 4. NUNCA subas el archivo .env real a Git
# 5. En Railway, configura las variables en el dashboard, NO en código
#
# =============================================================================
